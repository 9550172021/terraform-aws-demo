pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Find Terraform Files') {
            steps {
                sh '''
                find . -name "*.tf"
                '''
            }
        }

        stage('Terraform Validation') {
            steps {
                sh '''
                for dir in $(find . -type f -name "*.tf" | xargs -n1 dirname | sort -u)
                do
                    echo "Processing $dir"
                    cd $dir
                    terraform init -backend=false
                    terraform validate
                    cd -
                done
                '''
            }
        }
    }
}